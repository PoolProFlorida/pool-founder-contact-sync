Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# Block dot-directories such as .git and dotfiles such as .env.
RewriteRule (^|/)\. - [F,END]
# Only the public application entry points may execute from the web root.
# Old diagnostics and future standalone PHP scripts must not be web-accessible.
RewriteRule ^(?!index\.php$|login\.php$|logout\.php$|app-passwords\.php$|carddav\.php$)[^/]+\.php$ - [F,END,NC]
# This rule applies only within the installed subdirectory.
RewriteRule ^carddav(/.*)?$ carddav.php [END,QSA]
RewriteRule ^(?:src|config|storage|scripts|tests|docs)(?:/|$) - [F,END,NC]
</IfModule>

# Private files must never be returned by Apache, even if PHP is not running.
<FilesMatch "^(\.|composer\.(json|lock)$|README\.md$|LICENSE$|CONTRIBUTING\.md$|.*\.(?:log|json|sqlite|db|bak|ini|yml|yaml))">
Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
</IfModule>
