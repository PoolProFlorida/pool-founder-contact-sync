# Copy to .env on your server. Keep .env private; never commit it.
# Pool Founder API key needs read access to GET /api/v1/customers.
POOL_FOUNDER_API_KEY=replace-with-your-api-key

# Required for BOTH the private preview dashboard and CardDAV.
# Use a dedicated username and a long, unique password (at least 16 characters).
CARDDAV_USERNAME=poolcontacts
CARDDAV_PASSWORD=replace-with-a-long-unique-password
