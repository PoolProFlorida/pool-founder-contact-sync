# Private server-side settings. Never commit a populated .env.
POOL_FOUNDER_API_KEY=replace-with-your-api-key

# Required dashboard session login (no shared HTTP Basic Auth fallback).
# Generate an interactive password hash: php scripts/hash-dashboard-password.php
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH='paste-generated-password-hash-here'

# CardDAV uses a stable username plus a separate app password for each device.
# Create app passwords from the signed-in dashboard.
CARDDAV_USERNAME=poolcontacts

# Shared-password authentication is OFF by default and not needed by new users.
# Existing deployments: see docs/AUTHENTICATION.md BEFORE upgrading.
# Temporary migration only: CARDDAV_PASSWORD=existing-strong-legacy-password
# Temporary migration only: CARDDAV_LEGACY_ENABLED=1
# Remove the temporary flag or set it to 0 once every device is migrated.

# Optional host-specific PHP CLI path for copyable admin cron command.
# CRON_PHP_BINARY=/opt/cpanel/ea-php83/root/usr/bin/php
