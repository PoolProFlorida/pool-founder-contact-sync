# Copy to .env on your server. Keep .env private; never commit it.
# Pool Founder API key remains server-side and is used only for read requests.
POOL_FOUNDER_API_KEY=replace-with-your-api-key

# Stable CardDAV username. Existing DAV principal paths use this name.
CARDDAV_USERNAME=poolcontacts

# Existing CardDAV password (accepted during migration).
# Set CARDDAV_LEGACY_ENABLED=0 ONLY after all clients use app passwords.
CARDDAV_PASSWORD=replace-with-a-long-unique-password
# CARDDAV_LEGACY_ENABLED=0

# Optional modern dashboard login. Configure BOTH lines to enable.
# Generate the password hash using: php scripts/hash-dashboard-password.php
# Do not enter the plaintext password in this file.
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD_HASH='paste-generated-password-hash-here'

# Optional: full PHP CLI executable for the 30-minute cron command shown in admin.
# Only set when the automatically detected PHP path doesn't work on your host.
# CRON_PHP_BINARY=/opt/cpanel/ea-php83/root/usr/bin/php
